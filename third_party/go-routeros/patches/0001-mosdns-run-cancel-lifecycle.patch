--- a/proto/io_context.go
+++ b/proto/io_context.go
@@ -3,7 +3,7 @@ package proto
 import (
 	"bufio"
 	"io"
-	"sync/atomic"
+	"sync"
 )
 
 type ctxResult struct {
@@ -13,27 +13,16 @@ type ctxResult struct {
 
 type ctxReader struct {
 	io.Reader
-	close atomic.Bool
-	done  chan struct{}
+	done chan struct{}
+	once sync.Once
 }
 
 func (c *ctxReader) Close() {
-	if c.close.Load() {
-		return
-	}
-	c.close.Store(true)
-	close(c.done)
+	c.once.Do(func() { close(c.done) })
 }
 
 func (c *ctxReader) Cancel() {
-	if c.close.Load() {
-		return
-	}
-
-	select {
-	case c.done <- struct{}{}:
-	default:
-	}
+	c.once.Do(func() { close(c.done) })
 }
 
 func (c *ctxReader) Read(p []byte) (int, error) {
@@ -59,27 +48,16 @@ func (c *ctxReader) Read(p []byte) (int, error) {
 
