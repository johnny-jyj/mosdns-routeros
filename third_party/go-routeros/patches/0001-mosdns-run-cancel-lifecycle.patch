 }
 
 func (c *ctxWriter) Close() {
-	if c.close.Load() {
-		return
-	}
-	c.close.Store(true)
-	close(c.done)
+	c.once.Do(func() { close(c.done) })
 }
 
 func (c *ctxWriter) Cancel() {
-	if c.close.Load() {
-		return
-	}
-
-	select {
-	case c.done <- struct{}{}:
-	default:
-	}
+	c.once.Do(func() { close(c.done) })
 }
 
